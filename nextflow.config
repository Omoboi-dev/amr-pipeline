manifest {
    name            = 'Omoboi-dev/amr-pipeline'
    description     = 'Detect antimicrobial resistance genes in bacterial genomes'
    nextflowVersion = '>=25.04.0'
}

params {
    input     = null
    outdir    = 'results'
    assembler = 'spades'
}

process {
    cpus   = 2
    memory = 2.GB

    withName: 'FASTP' {
        cpus   = 4
        memory = 4.GB
    }
    withName: 'SHOVILL' {
        cpus     = 6
        // shovill 1.4 refuses to run with --ram below 8
        memory   = 8.GB
        // one assembly at a time to stay within laptop memory
        maxForks = 1
    }
    withName: 'QUAST' {
        cpus   = 4
        memory = 4.GB
    }
}

profiles {
    docker {
        docker.enabled    = true
        // run as the current user so output files are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    conda {
        conda.enabled = true
    }
}
